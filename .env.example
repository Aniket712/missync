# "demo": bundled synthetic data only, custom connections disabled (use for any public deployment)
# "self-hosted": connect your own databases
MISSYNC_MODE=self-hosted
MISSYNC_DATA_DIR=./data

# Fernet key used to encrypt stored connection secrets. Generated into data/.secret_key if empty.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MISSYNC_SECRET_KEY=

# Allow sqlite/duckdb/csv/parquet paths outside MISSYNC_DATA_DIR (off by default)
MISSYNC_ALLOW_LOCAL_PATHS=false
# Comma-separated allowlist for network connectors; empty = any non link-local host
MISSYNC_ALLOWED_HOSTS=
# Set false to block private/loopback addresses (recommended for shared deployments)
MISSYNC_ALLOW_PRIVATE_HOSTS=true

# Required to listen on a non-local address in self-hosted mode: every /api call must send "Authorization: Bearer <token>".
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MISSYNC_API_TOKEN=
# Only if an authenticating reverse proxy (or a loopback-only published port) already protects the server
MISSYNC_ALLOW_INSECURE_BIND=false

MISSYNC_MAX_CONCURRENT_ANALYSES=2
MISSYNC_ANALYSIS_DEADLINE_S=600
MISSYNC_HISTORY_LIMIT=500
MISSYNC_STATEMENT_TIMEOUT_S=30
MISSYNC_SAMPLE_LIMIT=200000
MISSYNC_CORS_ORIGINS=http://localhost:5173

# docker-compose only
POSTGRES_ADMIN_PASSWORD=change-me
